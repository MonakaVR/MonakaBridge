{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic physical criteria policy; adoption is a separate explicit manifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "monaka.physical-criteria.v2"
    },
    "enabled": {
      "type": "boolean"
    },
    "measurement_mode": {
      "const": "trajectory"
    },
    "scope": {
      "type": "object",
      "required": [
        "source",
        "input_space",
        "profile",
        "world_space"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "input_space": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "world_space": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "min_pairs",
        "min_inliers",
        "min_inlier_ratio",
        "rms_position",
        "rms_orientation",
        "max_position",
        "max_orientation"
      ],
      "properties": {
        "min_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "min_inliers": {
          "type": "integer",
          "minimum": 1
        },
        "min_inlier_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rms_position": {
          "type": "number",
          "minimum": 0
        },
        "rms_orientation": {
          "type": "number",
          "minimum": 0
        },
        "max_position": {
          "type": "number",
          "minimum": 0
        },
        "max_orientation": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "lifetime": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "semantic"
        },
        "not_before_utc_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "not_after_utc_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "additionalProperties": false
    },
    "all_pair_max_mode": {
      "const": "diagnostic"
    },
    "motion_quality": {
      "type": "object",
      "required": [
        "valid_ratio",
        "span_seconds",
        "accumulated_rotation_rad",
        "axis_diversity",
        "extent_m"
      ],
      "properties": {
        "valid_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "span_seconds": {
          "type": "number",
          "minimum": 0
        },
        "accumulated_rotation_rad": {
          "type": "number",
          "minimum": 0
        },
        "axis_diversity": {
          "type": "number",
          "minimum": 0
        },
        "extent_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "measurement_options": {
      "type": "object",
      "required": [
        "recording_seconds",
        "relative_motion_min_rad",
        "relative_motion_max_rad",
        "inlier_position_m",
        "inlier_orientation_rad"
      ],
      "properties": {
        "recording_seconds": {
          "type": "number",
          "minimum": 0
        },
        "relative_motion_min_rad": {
          "type": "number",
          "minimum": 0
        },
        "relative_motion_max_rad": {
          "type": "number",
          "minimum": 0
        },
        "inlier_position_m": {
          "type": "number",
          "minimum": 0
        },
        "inlier_orientation_rad": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "version",
    "schema",
    "enabled",
    "measurement_mode",
    "scope",
    "limits",
    "lifetime",
    "all_pair_max_mode",
    "motion_quality",
    "measurement_options"
  ],
  "additionalProperties": false
}
